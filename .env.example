# Environment Variables Example for DeliveryFraud Platform

# Secret Key for JWT Token Generation (Change in Production!)
SECRET_KEY=delivery_fraud_super_secret_jwt_key_2026_change_in_prod

# Database Configuration (SQLite default for dev, PostgreSQL for production)
# SQLite: sqlite:///./delivery_fraud.db
# PostgreSQL: postgresql://user:password@localhost:5432/delivery_fraud
DATABASE_URL=sqlite:///./delivery_fraud.db

# Enable Demo Seeding Mode (set to false in production)
DEMO_MODE=true

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# File Upload Directory & Max File Size
UPLOAD_DIR=./uploads
